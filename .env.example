# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# ── Auto-fix escalation (lessons 2.3.x) ─────────────────────────────
# The demo runner registers the Linear callback. Set LINEAR_MOCK=true to run the
# full escalation path and print the GraphQL payload instead of posting it.
LINEAR_MOCK=true
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# Jira variant of the same callback (swap which one is registered in
# scripts/autofix-pipeline.js). JIRA_MOCK behaves like LINEAR_MOCK.
JIRA_MOCK=true
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# ── Module 1 token-cost tool ────────────────────────────────────────
# Optional: exact token counts via the API instead of word/char estimates.
ANTHROPIC_API_KEY=
